<!doctype html>
<html lang="tr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#070707">
<meta name="referrer" content="no-referrer">
<title>WEİZEND ARENA • Turnuva Merkezi</title>
<style>
:root{font:14px/1.5 'Segoe UI',Tahoma,Arial,sans-serif;color-scheme:dark;--bg:#050505;--panel:#111;--line:#343434;--red:#e31b1b;--soft:#ff9999;--muted:#a5a5a5;--green:#6fdda1;--gold:#ffd47a}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:radial-gradient(ellipse 85% 340px at 50% 50px,#220909 0%,#050505 80%);color:#fff}button,a{font:inherit}button{cursor:pointer}button:disabled{cursor:not-allowed;opacity:.42}a{color:#ffaaaa}button:focus-visible,a:focus-visible{outline:2px solid #f66;outline-offset:2px}[hidden]{display:none!important}
header{background:#090909;border-bottom:1px solid #292929} .top{width:min(1360px,100%);padding:12px 17px;margin:auto;display:flex;align-items:center;justify-content:space-between;gap:14px} .brand{display:flex;align-items:center;gap:10px} .brand-logo{width:42px;height:42px;border:2px solid #ca2a2a;border-radius:50%;display:grid;place-items:center;font-weight:1000;font-size:23px;object-fit:cover;background:#080808;color:#fff} .brand strong{font-size:21px;letter-spacing:.05em}.brand strong span{color:#ff4545}.brand small{display:block;font-size:11px;color:#a7a7a7} .return{border:1px solid #383838;border-radius:9px;background:#1b1b1b;color:#fff;padding:9px 13px;text-decoration:none;font-weight:900}
main{width:min(1360px,100%);padding:18px 16px 55px;margin:auto}.hero{background:linear-gradient(115deg,#2b0b0b,#111);border:1px solid #873131;border-radius:15px;padding:18px 20px;margin-bottom:14px}.eyebrow{font-size:11px;font-weight:900;color:#ff9898;letter-spacing:.12em}.hero h1{font-size:clamp(20px,3vw,28px);margin:4px 0 7px}.hero p{margin:0;color:#d3c9c9}.stats{display:flex;gap:7px;flex-wrap:wrap;margin-top:13px}.tag{border:1px solid #424242;background:#1b1b1b;padding:5px 9px;border-radius:8px;color:#ddd;font-size:11px;font-weight:850}.tag.red{border-color:#793030;color:#ffaaaa;background:#280e0e}.grid{display:grid;grid-template-columns:minmax(0,1.7fr) minmax(290px,.85fr);gap:13px;align-items:start}.panel{background:linear-gradient(145deg,#111,#080808);border:1px solid #303030;padding:16px;border-radius:14px;min-width:0}.panel h2{margin:0 0 10px;font-size:18px}.panel h3{margin:14px 0 8px;font-size:15px}.hint{font-size:12px;color:#aaa;margin:0 0 12px}.notice{background:#1b1410;border:1px solid #6f4f26;color:#ffe1ac;border-radius:9px;padding:12px;margin-bottom:13px}.notice.error{background:#230e0e;border-color:#932a2a;color:#ffd1d1}.notice.ok{background:#101d15;border-color:#34774c;color:#b7ffce}
.bracket-viewport{overflow-x:auto;scrollbar-color:#872b2b #111}.rounds{display:flex;gap:12px;min-width:max-content;padding:4px 2px 13px}.round{width:214px;flex:none;display:flex;flex-direction:column}.round h3{padding:7px 10px;border-left:3px solid var(--red);background:#210f0f;margin:0 0 9px;font-size:12px}.round-matches{display:flex;flex-direction:column;justify-content:space-around;gap:11px;flex:1;min-height:315px}.match{width:100%;background:#171717;border:1px solid #393939;border-radius:10px;color:#fff;padding:10px;text-align:left;display:grid;gap:5px;min-height:80px}.match:hover,.match.active{border-color:var(--red)}.match-head{display:flex;justify-content:space-between;gap:4px;color:#aaa;font-size:10px}.side{display:flex;justify-content:space-between;gap:5px;font-weight:750;font-size:12px;overflow-wrap:anywhere}.side.winner{color:var(--green)}.side.predicted:not(.winner){color:var(--gold)}.side span{flex-shrink:0}.empty{border:1px dashed #404040;color:#aaa;border-radius:10px;background:#0c0c0c;text-align:center;padding:25px 14px}.match-focus{border:1px solid #3d3d3d;border-radius:10px;padding:12px;background:#0e0e0e;margin:7px 0}.focus-title{font-size:15px;font-weight:900;margin-bottom:9px;overflow-wrap:anywhere}.focus-line{color:#bbb;font-size:12px}.choices{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:10px 0}.choose{padding:12px 10px;border:1px solid #474747;background:#1e1e1e;border-radius:10px;color:white;font-weight:850;overflow-wrap:anywhere}.choose.selected{background:#462020;border-color:#ff5353;color:#fff}.choose:hover:not(:disabled){border-color:#f55}.pick-status{font-size:12px;color:#b9b9b9;margin:8px 0}.pick-status b{color:#fff}.btn{background:var(--red);border:1px solid var(--red);color:#fff;border-radius:9px;font-weight:900;padding:10px 12px}.btn.secondary{background:#1b1b1b;border-color:#3d3d3d}.toolbar{display:flex;justify-content:space-between;align-items:center;gap:9px;margin:12px 0}.small{font-size:11px;color:#aaa}.members{display:grid;gap:8px}.member{border:1px solid #373737;background:#161616;border-radius:9px;padding:9px 11px}.member strong{display:block}.member small{display:block;color:#a9a9a9;margin-top:3px;overflow-wrap:anywhere}.leaderboard{width:100%;border-collapse:collapse}.leaderboard th,.leaderboard td{border-bottom:1px solid #343434;padding:8px 4px;text-align:left;font-size:12px}.leaderboard th{color:#aaa}.count{font-variant-numeric:tabular-nums}.footer{text-align:center;color:#777;margin-top:23px;font-size:11px}.skeleton{height:10px;margin:11px 0;background:linear-gradient(90deg,#222,#383838,#222);background-size:200% 100%;animation:shimmer 1.5s infinite;border-radius:10px}@keyframes shimmer{to{background-position:-200% 0}}@media(max-width:960px){.grid{grid-template-columns:1fr}.round{width:200px}.round-matches{min-height:300px}}@media(max-width:520px){main{padding:12px 10px 45px}.panel{padding:12px}.hero{padding:15px}.brand strong{font-size:16px}.brand-logo{width:37px;height:37px;font-size:20px}.return{padding:9px 10px;font-size:12px}}
</style>
</head>
<body>
<header><div class="top"><div class="brand"><img class="brand-logo" alt="WEİZEND" src="data:image/webp;base64,"><div><strong>WEİZEND <span>ARENA</span></strong><small>Turnuva Merkezi</small></div></div><a class="return" href="https://weizend.github.io/weizendmarket/">← Siteye Dön</a></div></header>
<main>
<section class="hero"><div class="eyebrow">🏆 WEİZEND ARENA</div><h1 id="tournamentTitle">Turnuva bilgileri hazırlanıyor</h1><p id="tournamentSubtitle">Katılımcılar, fikstür, maç sonuçları ve tahminler tek yerde.</p><div class="stats" id="stats"></div></section>
<div id="alert" class="notice" role="status" hidden></div>
<div class="grid" id="content">
<section class="panel"><div class="toolbar"><h2>🏆 Turnuva Fikstürü</h2><button class="btn secondary" type="button" id="refreshBtn">↻ Yenile</button></div><p class="hint">Bir maça tıklayarak eşleşmeyi ve tahmin seçeneklerini incele.</p><div id="bracket" class="bracket-viewport"><div class="empty">Fikstür bilgileri alınıyor...</div></div></section>
<aside class="panel"><h2>🎮 Maç Bilgisi</h2><div id="matchInfo" class="match-focus">Maç seçilmesi bekleniyor.</div><div id="picksBox"><h3>🎯 Tahminim</h3><p id="authText" class="hint">Kick hesabı kontrol ediliyor...</p><div class="choices"><button class="choose" id="pickA" disabled>Oyuncu A</button><button class="choose" id="pickB" disabled>Oyuncu B</button></div><p id="pickProgress" class="pick-status">Tahmin durumu yükleniyor...</p><p class="small">Her seçim anında kaydedilir. Tahminler kapalıysa değişiklik yapılamaz.</p></div><hr style="border:0;border-top:1px solid #333;margin:16px 0"><h3>👥 Takımlar / Oyuncular</h3><div id="participants" class="members"><div class="small">Katılımcılar yükleniyor...</div></div><hr style="border:0;border-top:1px solid #333;margin:16px 0"><h3>🏅 Tahmin Sıralaması</h3><div id="predictionBoard" class="small">Sıralama yükleniyor...</div></aside>
</div>
<div class="footer">WEİZEND ARENA • Turnuva Merkezi</div>
</main>
<script>
(()=>{'use strict';
const API='https://weizend-botrix.weizendtv.workers.dev',TOKEN_KEY='weizend_market_session_secure_v2';
const $=s=>document.getElementById(s);
const esc=x=>String(x??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const clean=x=>String(x??'').trim();
const query=new URLSearchParams(location.search);const tid=clean(query.get('tournament'));
const state={tid,t:null,detail:null,pred:null,selected:null,loading:false,saving:false,authed:false,identityRequested:false};
const href='https://weizend.github.io/weizendmarket/';
const cacheKey='wz_arena_public_v1:'+tid;
function token(){try{return localStorage.getItem(TOKEN_KEY)||''}catch{return ''}}
function toast(message,kind=''){$('alert').hidden=false;$('alert').textContent=message;$('alert').className='notice '+kind;}
function hideToast(){$('alert').hidden=true;}
async function api(path,auth=false,data=null){const c=new AbortController(),timer=setTimeout(()=>c.abort(),16000);try{
 const h={'Accept':'application/json'};if(data!==null)h['Content-Type']='application/json';if(auth){const t=token();if(!t)throw Error('Kick oturumu bulunamadı. Siteye giriş yapıp yeniden dene.');h.Authorization='Bearer '+t;}
 const r=await fetch(API+path,{method:data===null?'GET':'POST',headers:h,body:data===null?undefined:JSON.stringify(data),cache:'no-store',signal:c.signal});
 const payload=await r.json().catch(()=>null);if(!r.ok||!payload?.success)throw Error(payload?.error||'İstek başarısız (HTTP '+r.status+').');return payload;
 }catch(e){if(e.name==='AbortError')throw Error('Bağlantı zaman aşımına uğradı. Yeniden dene.');throw e;}finally{clearTimeout(timer)}}
function rounds(matches){const map=new Map();for(const m of matches){const kind=clean(m.matchKind||'main'),r=Number(m.roundNumber||0),k=kind+':'+r;if(!map.has(k))map.set(k,{kind,round:r,matches:[]});map.get(k).matches.push(m);}return [...map.values()].sort((a,b)=>a.round-b.round|| (a.kind==='main'?-1:1)).map(r=>({...r,matches:r.matches.sort((a,b)=>Number(a.matchNumber)-Number(b.matchNumber))}));}
function keys(matches){return new Map(matches.map(m=>[(m.matchKind||'main')+':'+Number(m.roundNumber||0)+':'+Number(m.matchNumber||0),m]));}
function predMap(){return new Map((state.pred?.myPicks||[]).filter(p=>p.matchId&&p.winnerId).map(p=>[String(p.matchId),String(p.winnerId)]));}
function nameFor(id){if(!id)return'Bekleniyor';const d=state.detail||{};for(const m of d.matches||[]){if(String(m.participantAId)===String(id)&&m.participantAName)return m.participantAName;if(String(m.participantBId)===String(id)&&m.participantBName)return m.participantBName;if(String(m.winnerId)===String(id)&&m.winnerName)return m.winnerName;}for(const p of d.participants||[])if(String(p.id)===String(id))return p.username||p.name||'Oyuncu';for(const t of d.teams||[])if(String(t.id)===String(id))return t.name||'Takım';return'Bekleniyor';}
// Mirror the Market's projected bracket rules to render available selections.
// The server independently validates every posted winnerId.
function optionsFor(target){const all=state.detail?.matches||[],lookup=keys(all),picks=predMap();const maxRound=Math.max(0,...all.filter(m=>(m.matchKind||'main')==='main').map(m=>Number(m.roundNumber||0)));
 const seen=new Set();function evaluate(m){if(!m||seen.has(m.id))return[];seen.add(m.id);let a=[];const r=Number(m.roundNumber||0),kind=m.matchKind||'main';if(kind==='third_place'){
 const semi=Math.max(1,maxRound-1);const semis=[lookup.get('main:'+semi+':1'),lookup.get('main:'+semi+':2')].filter(Boolean);a=semis.map(x=>{const opts=evaluate(x),pick=picks.get(String(x.id));return opts.length===2&&pick&&opts.includes(pick)?opts.find(k=>k!==pick):null}).filter(Boolean);
 }else if(r<=1){a=[m.participantAId,m.participantBId].filter(Boolean);
 }else{a=[r*0+Number(m.matchNumber||0)*2-1,Number(m.matchNumber||0)*2].map(n=>{const prev=lookup.get('main:'+(r-1)+':'+n);if(!prev)return null;const opts=evaluate(prev);if(opts.length===1)return opts[0];const choice=picks.get(String(prev.id));return choice&&opts.includes(choice)?choice:null}).filter(Boolean)}
 seen.delete(m.id);return [...new Set(a.map(String).filter(Boolean))];}return evaluate(target)}
function activeMatch(){return (state.detail?.matches||[]).find(m=>m.id===state.selected)||null;}
function renderHero(){const t=state.t||{},loaded=!!state.detail;$('tournamentTitle').textContent=loaded?t.name||t.gameName||'Turnuva':'Turnuva bilgileri hazırlanıyor';$('tournamentSubtitle').textContent=loaded?`${t.gameName||'Oyun'} • ${t.mode==='solo'?'Solo':(t.teamSize||'?')+'v'+(t.teamSize||'?')} • ${t.bestOf||'BO1'}`:'Katılımcılar, fikstür, maç sonuçları ve tahminler tek yerde.';
 $('stats').innerHTML=loaded?`<span class="tag">${esc(t.gameName||'Oyun')}</span><span class="tag">${esc(t.bestOf||'BO1')}</span><span class="tag">${Number(t.registeredCount||0)} / ${Number(t.capacity||0)} katılım</span><span class="tag red">${state.detail.matches.length?'Fikstür Yayında':'Fikstür Bekleniyor'}</span>`:'';}
function projectedSlot(m,which){
 const actual=which==='a'?m.participantAId:m.participantBId;if(actual)return String(actual);
 const r=Number(m.roundNumber||0);if(r<=1||(m.matchKind||'main')!=='main')return null;
 const predecessor=keys(state.detail?.matches||[]).get('main:'+(r-1)+':'+(Number(m.matchNumber||0)*2-(which==='a'?1:0)));
 if(!predecessor)return null;
 return predecessor.winnerId||predMap().get(String(predecessor.id))||null;
}
function displayName(m,which){const given=which==='a'?m.participantAName:m.participantBName;
 if(given&&given!=='Bekleniyor')return given;
 const from=projectedSlot(m,which);if(from)return nameFor(from);
 const r=Number(m.roundNumber||0);if(r>1&&(m.matchKind||'main')==='main')return 'Önceki tur galibi';
 return'Bekleniyor';}
function renderBracket(){const matches=state.detail?.matches||[];if(!matches.length){$('bracket').innerHTML='<div class="empty">Henüz fikstür yayımlanmadı. Katılımlar tamamlanıp eşleşmeler oluşturulduğunda burada görünecek.</div>';return;}
 const picks=predMap();$('bracket').innerHTML='<div class="rounds">'+rounds(matches).map((r)=>'<section class="round"><h3>'+ (r.kind==='third_place'?'🥉 Üçüncülük':r.round===Math.max(...matches.filter(m=>(m.matchKind||'main')==='main').map(m=>Number(m.roundNumber)))?'🏆 Final':r.round===1?'1. Tur':r.round+'. Tur')+' • '+r.matches.length+' maç</h3><div class="round-matches">'+r.matches.map(m=>{
 const aId=projectedSlot(m,'a'),bId=projectedSlot(m,'b');const s1=picks.get(String(m.id))===String(aId)&&!!aId,s2=picks.get(String(m.id))===String(bId)&&!!bId;
 const a=m.winnerId&&String(m.winnerId)===String(aId),b=m.winnerId&&String(m.winnerId)===String(bId);
 return `<button class="match ${state.selected===m.id?'active':''}" type="button" data-mid="${esc(m.id)}"><div class="match-head"><span>M${Number(m.matchNumber)||'?'} · ${Number(m.roundNumber)||'?'}. tur</span><span>${m.status==='completed'?'SONUÇLANDI':'BEKLİYOR'}</span></div><div class="side ${a?'winner':s1?'predicted':''}"><strong>${esc(displayName(m,'a'))}</strong><span>${a?'✓':s1?'★':''}</span></div><div class="side ${b?'winner':s2?'predicted':''}"><strong>${esc(displayName(m,'b'))}</strong><span>${b?'✓':s2?'★':''}</span></div></button>`;
 }).join('')+'</div></section>').join('')+'</div>';
 document.querySelectorAll('[data-mid]').forEach(btn=>btn.addEventListener('click',()=>{state.selected=btn.dataset.mid;renderBracket();renderMatch();}));}
function renderMatch(){const m=activeMatch();if(!m){$('matchInfo').textContent=state.detail?.matches?.length?'Bir maç seç.':'Fikstür bekleniyor.';$('pickA').disabled=$('pickB').disabled=true;$('pickProgress').textContent='Henüz maç bulunmuyor.';return;}
 const done=String(m.status||'')==='completed';$('matchInfo').innerHTML=`<div class="focus-title">${esc(displayName(m,'a'))} <span style="color:#a1a1a1">VS</span> ${esc(displayName(m,'b'))}</div><div class="focus-line">${Number(m.roundNumber)||'?'} . Tur · M${Number(m.matchNumber)||'?'} · ${done?'Maç tamamlandı':'Sonuç bekleniyor'}</div>${m.winnerId?'<div class="pick-status" style="color:var(--green)">✓ Kazanan: '+esc(nameFor(m.winnerId))+'</div>':''}`;
 const chosen=predMap().get(String(m.id)),opts=optionsFor(m),open=state.pred?.prediction?.open===true,allow=state.authed&&open&&!state.saving&&opts.length===2&&m.status!=='completed';
 for(let i=0;i<2;i++){const el=i===0?$('pickA'):$('pickB'),id=opts[i];el.dataset.winner=id||'';el.textContent=id?nameFor(id):(i?'B tarafı bekleniyor':'A tarafı bekleniyor');el.disabled=!allow||!id;el.classList.toggle('selected',!!id&&chosen===String(id));}
 const all=state.detail.matches.length,n=state.pred?.myPicks?.length||0;
 $('pickProgress').innerHTML=state.pred?`<b>${n}/${all}</b> tahmin kaydedildi · ${open?'Tahminler açık':'Tahminler kapalı'}`:'Tahmin durumu hazırlanıyor...';
 $('authText').textContent=state.authed?'Kick oturumun doğrulandı. Bir tarafa basarak tahminini kaydedebilirsin.':token()?'Oturum doğrulanıyor...':'Tahmin yapmak için önce WEİZEND sitesinden Kick hesabına giriş yap.';
}
function renderParticipants(){const d=state.detail||{},teams=d.teams||[],people=d.participants||[];
 if(!teams.length&&!people.length){$('participants').innerHTML='<div class="small">Henüz kayıtlı katılımcı bulunmuyor.</div>';return;}
 $('participants').innerHTML=teams.length?teams.map(t=>`<div class="member"><strong>${esc(t.name||'Takım')}</strong><small>${esc((t.members||[]).map(p=>p.username||p.plannedUsername||'Oyuncu').join(' • ')||'Kadro bekleniyor')}</small></div>`).join(''):people.map(p=>`<div class="member"><strong>${esc(p.username||p.name||'Oyuncu')}</strong></div>`).join('');}
function renderBoard(){if(!state.pred){$('predictionBoard').textContent='Tahmin sıralaması yükleniyor...';return;}
 const list=state.pred.leaderboard||[];if(!list.length){$('predictionBoard').textContent='Henüz tahmin yapan yok.';return;}
 $('predictionBoard').innerHTML=`<table class="leaderboard"><thead><tr><th>#</th><th>Kick Kullanıcısı</th><th>Puan</th><th>Doğru</th></tr></thead><tbody>`+list.slice(0,50).map(x=>`<tr><td>${Number(x.rank)||0}</td><td>${esc(x.username)}</td><td class="count">${Number(x.score)||0}</td><td class="count">${Number(x.correctCount)||0}</td></tr>`).join('')+'</tbody></table>';
}
function renderAll(){renderHero();renderBracket();renderParticipants();renderMatch();renderBoard();}
function cachePublic(){try{sessionStorage.setItem(cacheKey,JSON.stringify({at:Date.now(),detail:state.detail}));}catch{}}
function restorePublic(){try{const v=JSON.parse(sessionStorage.getItem(cacheKey)||'null');if(!v||Date.now()-Number(v.at)>12*3600*1000||v.detail?.tournament?.id!==tid)return;state.detail=v.detail;state.t=v.detail.tournament;state.selected=v.detail.matches?.[0]?.id||null;renderAll();}catch{}}
async function refresh(initial=false){if(state.loading)return;state.loading=true;$('refreshBtn').disabled=true;
 try{const [detail,pred]=await Promise.all([api('/tournament/public?id='+encodeURIComponent(tid)),api('/tournament/predictions?id='+encodeURIComponent(tid))]);
 if(detail?.tournament?.id!==tid)throw Error('Sunucudan beklenen turnuva dönmedi.');
 state.detail=detail;state.t=detail.tournament;cachePublic();state.pred=pred;const matches=detail.matches||[];if(!matches.some(m=>m.id===state.selected))state.selected=matches[0]?.id||null;
 hideToast();renderAll();
 if(token()){try{const own=await api('/tournament/predictions/me?id='+encodeURIComponent(tid),true);state.pred=own;state.authed=true;renderAll();}catch(e){state.authed=false;state.pred=pred;renderAll();toast('Kick oturumu doğrulanamadı. Tahmin yapmak için siteye yeniden giriş yap.', 'error');}}
 else {state.authed=false;renderMatch();}
 }catch(e){if(state.detail){toast('Güncel bilgiler alınamadı. Son görüntülenen turnuva korunuyor. '+e.message,'error');}else{toast('Turnuva açılamadı: '+e.message,'error');$('tournamentTitle').textContent='Turnuva yüklenemedi';$('bracket').innerHTML='<div class="empty">Bağlantıyı kontrol edip Yenile butonuna bas.</div>';}}
 finally{state.loading=false;$('refreshBtn').disabled=false}}
async function savePick(i){const m=activeMatch();if(!m||state.saving||!state.authed||state.pred?.prediction?.open!==true)return;const id=(i===0?$('pickA'):$('pickB')).dataset.winner;if(!id)return;
 state.saving=true;renderMatch();try{const p=await api('/tournament/predictions/pick',true,{tournamentId:tid,matchId:m.id,winnerId:id});state.pred=p;state.authed=true;toast('✓ Tahminin hesabına kaydedildi.','ok');renderAll();}catch(e){toast('Tahmin kaydedilemedi: '+e.message,'error');await refresh();}finally{state.saving=false;renderMatch()}}
$('refreshBtn').onclick=()=>refresh();$('pickA').onclick=()=>savePick(0);$('pickB').onclick=()=>savePick(1);
if(!tid||tid.length>120||!/^[a-zA-Z0-9_:-]+$/.test(tid)){
 $('tournamentTitle').textContent='Turnuva seçilmedi';$('bracket').innerHTML='<div class="empty">Bir turnuvanın Arena bağlantısını aç. <a href="'+href+'">Siteye dön</a>.</div>';$('pickProgress').textContent='Turnuva bekleniyor.';$('authText').textContent='';$('participants').textContent='';$('predictionBoard').textContent='';$('refreshBtn').disabled=true;
}else{restorePublic();refresh(true)}
})();
</script>
</body>
</html>
